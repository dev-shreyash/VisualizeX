# ==============================================================================
# VisualizeX Environment Configuration Template
# ==============================================================================

# ==============================================================================
# PART 1: LINUX VPS BACKEND (.env file on VPS for /server)
# Place these variables in .env in your VPS project directory:
# ==============================================================================

# 1. Reverse Proxy Domain & SSL
# Point an A/CNAME record (e.g. api.yourdomain.com) to your VPS IP address
API_DOMAIN=api.yourdomain.com
LETSENCRYPT_EMAIL=admin@yourdomain.com

# 2. Server-to-Server Internal Security
# MUST MATCH the INTERNAL_SERVICE_SECRET configured on Vercel!
# Generate with: openssl rand -hex 32
INTERNAL_SERVICE_SECRET=generate_with_openssl_rand_hex_32
REQUIRE_S2S_AUTH=true

# 3. MongoDB Atlas Cloud Connection String
# Paste your MongoDB Atlas URI here:
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/CODES?retryWrites=true&w=majority
MONGODB_DB_NAME=CODES
# Default collection is "users" for backward compatibility with existing data
MONGODB_CODE_COLLECTION=users

# 4. Execution Sandbox Controls
MAX_CONCURRENT=5
EXECUTION_TIMEOUT_MS=3000
MAX_SOURCE_BYTES=65536
MAX_INPUT_BYTES=65536
MAX_OUTPUT_BYTES=65536

# 5. Host Paths & Docker Socket
HOST_WORKSPACE_PATH=/tmp/visualizex-workspaces
# For Rootless Docker (recommended): /run/user/<UID>/docker.sock
# For standard Docker: /var/run/docker.sock
DOCKER_SOCKET_PATH=/var/run/docker.sock
RUNNER_IMAGE=visualizex-runner:latest
CLIENT_URL=*

# ==============================================================================
# PART 2: VERCEL FRONTEND CONFIGURATION (/app on Vercel)
# Add these variables in Vercel Dashboard -> Settings -> Environment Variables:
# ==============================================================================
#
# INTERNAL_API_URL=https://api.yourdomain.com
# INTERNAL_SERVICE_SECRET=<SAME_SECRET_GENERATED_ABOVE>
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# NEXTAUTH_URL=https://your-app.vercel.app
# NEXTAUTH_SECRET=<generate_with_openssl_rand_base64_32>
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api
# GOOGLE_CLIENT_ID=<optional>
# GOOGLE_CLIENT_SECRET=<optional>
# GITHUB_CLIENT_ID=<optional>
# GITHUB_CLIENT_SECRET=<optional>
#
# ==============================================================================
